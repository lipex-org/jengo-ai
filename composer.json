{
  "name": "jengo/ai",
  "description": "Unified, multi-provider AI SDK and Agentic Engine for CodeIgniter 4 and the Jengo Framework.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Ochieng",
      "email": "ochiengian383@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.6",
    "jengo/base": "^1.1|dev-main"
  },
  "suggest": {
    "jengo/schema": "Required for building autonomous database tools and schema-driven RAG pipelines"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../base"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jengo\\Ai\\": "src/"
    },
    "files": [
      "src/Helpers/ai_helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit --no-coverage --colors=always"
  }
}
